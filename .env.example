# Copy this file to .env and fill in your key(s).
# Provide at least one API key. If BOTH are set, GROQ_API_KEY takes precedence
# (requests go to Groq's API with default model whisper-large-v3-turbo).
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides — remove the leading '#' to use; leave unset otherwise.
# Model name. Defaults: whisper-large-v3-turbo (Groq) / gpt-4o-transcribe (OpenAI).
#TRANSCRIBE_MODEL=whisper-1
# Transcription language (ISO-639-1). Default: en (forced English).
#TRANSCRIBE_LANGUAGE=en
# API request timeout in seconds (default 600).
#OPENAI_TIMEOUT=600
# Target max size per audio chunk in MB before uploading (default 24).
#CHUNK_TARGET_MB=24
# MP3 bitrate for extracted audio, e.g. 64k, 96k, 128k (default 96k).
#AUDIO_BITRATE=96k
