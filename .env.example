# Copy this file to .env and fill in your key(s).
# Provide at least one API key. If BOTH are set, GROQ_API_KEY takes precedence
# (requests go to Groq's API with default model whisper-large-v3).
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides — remove the leading '#' to use; leave unset otherwise.
# Model name. Defaults: whisper-large-v3 (Groq) / gpt-4o-transcribe (OpenAI).
#TRANSCRIBE_MODEL=whisper-1
# Language hint (ISO-639-1), e.g. ru or ro. Default: unset = auto-detect the
# spoken language; the transcript stays in that language.
#TRANSCRIBE_LANGUAGE=ru
# API request timeout in seconds (default 600).
#OPENAI_TIMEOUT=600
# Safety-net max size per audio chunk in MB (default 24). Only used if the
# silence-aware splitter below fails; normal chunks are far smaller.
#CHUNK_TARGET_MB=24
# MP3 bitrate for extracted audio, e.g. 64k, 96k, 128k (default 96k).
#AUDIO_BITRATE=96k

# --- Silence-aware chunking ---------------------------------------------------
# Audio is split into short segments so Whisper re-detects the language on each
# one; this is what keeps multilingual meetings from being garbled. Leave
# TRANSCRIBE_LANGUAGE unset (auto-detect) for mixed-language recordings.
# Aim to cut a segment around this many seconds, snapped to the nearest pause.
# Shorter = more frequent per-segment language re-detection (good for mixed
# languages); going below ~20s starts to hurt accuracy.
#CHUNK_TARGET_SEC=25
# Hard cap: force a cut by here even if no pause is found (default 40).
#CHUNK_MAX_SEC=40
# silencedetect noise floor; louder rooms may need -25dB (default -30dB).
#SILENCE_NOISE_DB=-30dB
# Minimum pause length (seconds) that counts as a cut point (default 0.5).
#SILENCE_MIN_SEC=0.5
# How many segments to transcribe concurrently (default 4; keep modest for
# Groq rate limits).
#MAX_CONCURRENCY=4

# --- Hallucination filtering (whisper models only) ----------------------------
# Drop no-speech and repetition-loop segments. Defaults are Whisper's own.
#NO_SPEECH_THRESHOLD=0.6
#LOGPROB_THRESHOLD=-1.0
#COMPRESSION_RATIO_THRESHOLD=2.4
